+	c := getCommand(NoDuplicateArgs, false)
+	_, err := executeCommand(c, "one", "one")
+	noDuplicateArgsWithDuplicate(err, t, "one")
+}
+
+func TestNoDuplicateArgs_WithValid_WithDuplicateArgs(t *testing.T) {
+	c := getCommand(NoDuplicateArgs, true)
+	_, err := executeCommand(c, "one", "one")
+	noDuplicateArgsWithDuplicate(err, t, "one")
