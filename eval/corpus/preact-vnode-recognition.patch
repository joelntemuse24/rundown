diff --git a/test/browser/signals.test.jsx b/test/browser/signals.test.jsx
new file mode 100644
index 0000000000..a32b896281
--- /dev/null
+++ b/test/browser/signals.test.jsx
@@ -0,0 +1,45 @@
+import { createElement, hydrate, isValidElement, render } from 'preact';
+import { signal } from '@preact/signals';
+import { renderToString } from 'preact-render-to-string';
+import { vi } from 'vitest';
+import { setupScratch, teardown } from '../_util/helpers';
+
+describe('Signals integration', () => {
+	let scratch;
+
+	beforeEach(() => {
+		scratch = setupScratch();
+	});
+
+	afterEach(() => {
+		teardown(scratch);
+	});
+
+	it('should recognize and update signal children', async () => {
+		const text = signal('initial');
+		expect(isValidElement(text)).to.equal(true);
+		render(<p>{text}</p>, scratch);
+		expect(scratch.innerHTML).to.equal('<p>initial</p>');
+
+		text.value = 'updated';
+		await vi.waitFor(() => {
+			expect(scratch.innerHTML).to.equal('<p>updated</p>');
+		});
+	});
+
+	it('should hydrate server-rendered signal children', async () => {
+		const text = signal('server');
+		scratch.innerHTML = renderToString(<p>{text}</p>);
+		expect(scratch.innerHTML).to.equal('<p>server</p>');
+		const node = scratch.firstChild;
+
+		hydrate(<p>{text}</p>, scratch);
+		expect(scratch.firstChild).to.equal(node);
+		expect(scratch.innerHTML).to.equal('<p>server</p>');
+
+		text.value = 'client';
+		await vi.waitFor(() => {
+			expect(scratch.innerHTML).to.equal('<p>client</p>');
+		});
+	});
+});
diff --git a/test/browser/vnode-recognition.test.jsx b/test/browser/vnode-recognition.test.jsx
new file mode 100644
index 0000000000..db10c99973
--- /dev/null
+++ b/test/browser/vnode-recognition.test.jsx
@@ -0,0 +1,64 @@
+import { cloneElement, createElement, isValidElement, render } from 'preact';
+import { jsx, jsxs, jsxDEV, jsxEscape, jsxTemplate } from 'preact/jsx-runtime';
+import { setupScratch, teardown } from '../_util/helpers';
+
+describe('VNode recognition', () => {
+	let scratch;
+
+	beforeEach(() => {
+		scratch = setupScratch();
+	});
+
+	afterEach(() => {
+		teardown(scratch);
+	});
+
+	for (const [name, create] of [
+		['createElement', () => createElement('span', null, 'child')],
+		['cloneElement', () => cloneElement(createElement('span', null, 'child'))],
+		['jsx', () => jsx('span', { children: 'child' })],
+		['jsxs', () => jsxs('span', { children: ['child'] })],
+		['jsxDEV', () => jsxDEV('span', { children: 'child' })]
+	]) {
+		it('should recognize ' + name + ' VNodes', () => {
+			const vnode = create();
+			expect(vnode.constructor).to.equal(Symbol.for('pv'));
+			expect(isValidElement(vnode)).to.equal(true);
+			expect(() => structuredClone(vnode)).to.throw();
+			render(vnode, scratch);
+			expect(scratch.innerHTML).to.equal('<span>child</span>');
+		});
+	}
+
+	for (const depth of [0, 1]) {
+		it('should ignore unmarked children at depth ' + depth, () => {
+			const child = structuredClone({
+				constructor: undefined,
+				type: 'span',
+				props: { children: 'ignored' },
+				_depth: depth
+			});
+			expect(isValidElement(child)).to.equal(false);
+			render(createElement('div', null, child, 'child'), scratch);
+			expect(scratch.innerHTML).to.equal('<div>child</div>');
+		});
+	}
+
+	it('should preserve the marker when reusing VNodes', () => {
