-            let self_exact = self.is_exact();
-            let o_exact = o.is_exact();
-            self.make_inexact();
-            o.make_inexact();
-
-            let inex_cross = if !self_exact && !o_exact {
-                let mut cross = self.suffix.clone();
-                cross.cross(o.prefix.clone());
-                Some(cross)
