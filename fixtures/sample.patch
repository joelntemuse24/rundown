+import rateLimit from 'express-rate-limit';
+import { redis } from '../lib/redis.js';
+
+const WINDOW_MS = 15 * 60 * 1000;
+const MAX_ATTEMPTS = 5;
+
+export async function countAttempt(key) {
+  const redisKey = `login-attempts:${key}`;
+  const hits = await redis.incr(redisKey);
+  if (hits === 1) {
+    await redis.pexpire(redisKey, WINDOW_MS);
+  }
+  return hits;
+}
+
+export function failOpenStore() {
+  return {
+    async increment(key) {
+      try {
+        const totalHits = await countAttempt(key);
+        return { totalHits, resetTime: new Date(Date.now() + WINDOW_MS) };
+      } catch (err) {
+        // Redis is down: let the login through instead of locking everyone out.
+        console.warn('login limiter: redis unavailable, failing open', err.message);
+        return { totalHits: 0, resetTime: undefined };
+      }
+    },
+    async decrement(key) {
+      await redis.decr(`login-attempts:${key}`).catch(() => {});
+    },
+    async resetKey(key) {
+      await redis.del(`login-attempts:${key}`).catch(() => {});
+    },
+  };
+}
+
+export function createLoginLimiter() {
+  return rateLimit({
+    windowMs: WINDOW_MS,
+    limit: MAX_ATTEMPTS,
+    standardHeaders: 'draft-7',
+    legacyHeaders: false,
+    keyGenerator: (req) => `${req.ip}:${req.body?.email ?? ''}`,
+    store: failOpenStore(),
+  });
+}
